# Copy to .env and fill in. .env is gitignored — never commit a real key.
#   PowerShell:  Copy-Item .env.example .env

# Which provider answers. gemini (free tier) | ollama (free, local) | anthropic (paid)
LLM_PROVIDER=gemini

# Free key, no credit card: https://aistudio.google.com/apikey
# AI Studio keys start with "AIzaSy".
GEMINI_API_KEY=

# Only needed for the other providers:
# OLLAMA_MODEL=qwen2.5:7b
# ANTHROPIC_API_KEY=
